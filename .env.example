# Copy this template to .env in the repository root. Do not commit credentials.
# Generation and the trainer load .env; exported variables take precedence.
# Other entry points may require credentials to be exported in the terminal.

# Required for OpenAI sentence generation.
OPENAI_API_KEY=

# Optional: Hugging Face authentication for training uploads.
HF_TOKEN=

# Required for W&B logging unless already authenticated with wandb login.
WANDB_API_KEY=

# Keep generation model settings, W&B entity/project, and HF repo settings
# in project_config.ini rather than this credentials file.
